# Local Postgres (see docker-compose.yml, or any local Postgres 16+)
DATABASE_URL=postgres://payload:payload@localhost:5433/jacobdubail

# Long random string. Generate with: openssl rand -hex 32
PAYLOAD_SECRET=change-me

# Public URL of the site (used for metadata, sitemap, RSS)
NEXT_PUBLIC_SERVER_URL=http://localhost:3001

# Vercel Blob for media uploads. Leave empty locally to store uploads on disk in /media.
BLOB_READ_WRITE_TOKEN=

# Optional: first admin user created by `pnpm seed`
SEED_ADMIN_EMAIL=jacob@example.com
SEED_ADMIN_PASSWORD=change-me-too
